<%= form_with(model: cooking) do |form| %>
  <% if cooking.errors.any? %>
    <div style="color: red;">
      <h2><%= pluralize(cooking.errors.count, "error") %></h2>
      <ul>
        <% cooking.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "料理名" %><br>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :content, "説明" %><br>
    <%= form.text_area :content %>
  </div>

  <div>
    <%= form.label :genre_id, "ジャンル" %><br>
    <%= form.collection_select :genre_id, Genre.all, :id, :name,
        { include_blank: "選択してください" } %>
  </div>

  <div>
    <%= form.submit "保存" %>
  </div>
<% end %>